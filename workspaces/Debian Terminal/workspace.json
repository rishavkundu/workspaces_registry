{
	"description": "A minimal Debian Bookworm desktop workspace with a terminal and basic tools.",
	"docker_registry": "https://ghcr.io",
	"image_src": "debian-terminal.png",
	"run_config": {
		"hostname": "kasm"
	},
	"exec_config": {
		"go": {
			"cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
		},
		"assign": {
			"cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
		}
	},
	"categories": ["Desktop", "Development"],
	"friendly_name": "Debian Terminal",
	"architecture": ["amd64"],
	"compatibility": [
		{
			"version": "1.17.x",
			"image": "ghcr.io/rishavkundu/kasm-debian-terminal:1.17.0",
			"uncompressed_size_mb": 0,
			"available_tags": ["develop", "1.17.0", "latest"]
		}
	]
}
