{
    "description": "Debian 12 XFCE desktop with Hermes agent stub",
    "docker_registry": "https://ghcr.io",
    "image_src": "NousDebianXFCE.png",
    "run_config": {
        "hostname": "kasm",
        "cpu_allocation_method": "Shares",
        "cpu_shares": 1024,
        "memory": 2147483648,
        "shm_size": 536870912
    },
    "exec_config": {
        "first_launch": {
            "cmd": "bash -c 'if [ -f /dockerstartup/custom_startup.sh ]; then /dockerstartup/custom_startup.sh; fi'",
            "environment": {}
        }
    },
    "categories": ["Desktop", "Development"],
    "friendly_name": "NousDebian",
    "architecture": ["amd64"],
    "compatibility": [
        {
            "version": "1.17.x",
            "image": "ghcr.io/rishavkundu/nousdebian:sha-7f48490",
            "uncompressed_size_mb": 0,
            "available_tags": ["latest"]
        }
    ],
    "persistent_profile_path": "/home/{username}",
    "volume_mappings": {},
    "notes": "Custom Debian 12 XFCE desktop with Hermes agent for workspace management."
}
